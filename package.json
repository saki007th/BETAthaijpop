{
    "name": "ultimate-jp-mix",
    "version": "19.0.0",
    "description": "Ultimate JP Mix - Discord Rich Presence bridge (โหลดเว็บจาก GitHub Pages)",
    "main": "electron/main.js",
    "scripts": {
        "start": "electron .",
        "dev": "electron .",
        "pack:win": "electron-builder --win portable",
        "release": "electron-builder --win --publish always"
    },
    "devDependencies": {
        "electron": "^31.0.0",
        "electron-builder": "^24.13.3"
    },
    "build": {
        "appId": "com.ultimatejpmix.app",
        "productName": "Ultimate-JP-Mix",
        "win": {
            "target": [
                {
                    "target": "portable",
                    "arch": ["x64"]
                }
            ],
            "artifactName": "Ultimate-JP-Mix-Portable.${ext}"
        },
        "files": [
            "electron/**/*"
        ]
    }
}
